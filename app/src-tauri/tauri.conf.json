{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Drive",
  "mainBinaryName": "drive-app",
  "version": "0.1.0",
  "identifier": "com.samcannas.drive",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Drive contributors",
    "copyright": "MIT License",
    "category": "Utility",
    "shortDescription": "Encrypted cloud drive for uloz.to",
    "longDescription": "Drive keeps a folder on your computer in sync with uloz.to. Files are encrypted on your device before they upload, in a format compatible with rclone crypt.",
    "homepage": "https://github.com/samcannas/drive",
    "externalBin": ["binaries/drive"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
